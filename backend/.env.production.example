# Railway'e bu değerleri "Variables" sekmesinden gir
NODE_ENV=production
PORT=3000

# Railway PostgreSQL plugin otomatik doldurur:
DATABASE_URL=postgresql://...   # Railway bunu otomatik set eder
# VEYA ayrı ayrı:
DB_USER=postgres
DB_HOST=...railway.internal
DB_NAME=railway
DB_PASSWORD=...
DB_PORT=5432

# Güçlü, rastgele bir secret üret (örn: openssl rand -hex 32)
JWT_SECRET=buraya-guclu-bir-secret-yaz

# Gmail app password için: Google Account → Security → 2FA → App Passwords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=uygulamanin@gmail.com
MAIL_PASS=xxxx-xxxx-xxxx-xxxx
MAIL_FROM_NAME=SporlaConnect
MAIL_FROM_EMAIL=uygulamanin@gmail.com

# Frontend'in adresi (Railway domain veya kendi domainin)
APP_URL=https://sporlaconnect.up.railway.app
VITE_API_URL=https://sporlaconnect.up.railway.app/api
VITE_BASE_URL=https://sporlaconnect.up.railway.app
