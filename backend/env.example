# SporlaConnect Environment Variables
# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizi girin
# UYARI: .env dosyasını asla Git'e commit etmeyin!

# Server Configuration
NODE_ENV=development
PORT=3000

# JWT Secret (En az 32 karakter, güçlü bir şifre)
JWT_SECRET=sporlaconnect-super-secret-key-123456789

# Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_NAME=sporlaconnect
DB_PASSWORD=
DB_PORT=5432

# Redis Configuration (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# iyzico Payment Gateway
# https://sandbox-merchant.iyzipay.com/auth/login (Test için)
# https://merchant.iyzipay.com/auth/login (Production için)
IYZICO_API_KEY=your-iyzico-api-key
IYZICO_SECRET_KEY=your-iyzico-secret-key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Firebase Cloud Messaging (Push Notifications)
# Firebase Console: https://console.firebase.google.com/
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"

# AWS Configuration (for file uploads)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-central-1
AWS_S3_BUCKET=sporlaconnect-uploads

# Email Configuration (SendGrid or SMTP)
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@sporlaconnect.com

# SMS Configuration (Twilio or local provider)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+905551234567

# Sentry Error Tracking (optional)
SENTRY_DSN=your-sentry-dsn-url

# Google Maps API (for geocoding and maps)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,https://sporlaconnect.com

# Session Configuration
SESSION_SECRET=your-session-secret-key-min-32-chars
SESSION_MAX_AGE=86400000

# File Upload Limits
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,image/gif

# App URLs
WEB_APP_URL=https://sporlaconnect.com
MOBILE_APP_DEEP_LINK=sporlaconnect://

# Admin Configuration
ADMIN_EMAIL=admin@sporlaconnect.com
ADMIN_PASSWORD=change-this-strong-password

# Feature Flags
ENABLE_NOTIFICATIONS=true
ENABLE_PAYMENTS=true
ENABLE_CHAT=false
ENABLE_VIDEO_UPLOAD=false

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
# Claude API (yarış keşfi taraması için)
ANTHROPIC_API_KEY=sk-ant-...
