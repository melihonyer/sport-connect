{
  "appId": "app.muuvlink",
  "appName": "Muuvlink",
  "webDir": "dist",
  "server": {
    "url": "https://muuvlink.app?src=app",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": ["muuvlink.app", "*.muuvlink.app"]
  },
  "ios": {
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#114956",
      "showSpinner": false,
      "androidSplashResourceName": "splash",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#114956"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK",
      "resizeOnFullScreen": true
    }
  }
}
