{
  "appId": "app.muuvlink",
  "appName": "Muuvlink",
  "webDir": "dist",
  "server": {
    "url": "https://muuvlink.app?src=app",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": ["muuvlink.app", "*.muuvlink.app"]
  },
  "ios": {
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#114956",
      "showSpinner": false,
      "androidSplashResourceName": "splash",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "_not": "Eklenti acilista setBackgroundColor'i KOSULSUZ cagiriyor ve varsayilani",
      "_not2": "siyah (#000000). Deger vermezsek durum cubugu siyah kaliyor. Android 15+",
      "_not3": "bu rengi zaten yok sayar; 14 ve altinda paletteki White Smoke gorunur.",
      "style": "LIGHT",
      "backgroundColor": "#F4F4F4"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK",
      "resizeOnFullScreen": true
    }
  }
}
