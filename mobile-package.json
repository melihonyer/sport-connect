{
  "name": "SporlaConnect",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace SporlaConnect.xcworkspace -scheme SporlaConnect -configuration Release",
    "bundle:android": "cd android && ./gradlew bundleRelease",
    "clean": "cd android && ./gradlew clean && cd ../ios && xcodebuild clean"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.73.2",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "react-native-screens": "^3.29.0",
    "react-native-safe-area-context": "^4.8.2",
    "react-native-gesture-handler": "^2.14.1",
    "react-native-maps": "^1.10.0",
    "react-native-geolocation-service": "^5.3.1",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "react-native-vector-icons": "^10.0.3",
    "@react-native-community/netinfo": "^11.2.1",
    "react-native-image-picker": "^7.1.0",
    "react-native-push-notification": "^8.1.1",
    "@react-native-firebase/app": "^19.0.1",
    "@react-native-firebase/messaging": "^19.0.1",
    "axios": "^1.6.5",
    "date-fns": "^3.2.0",
    "react-native-calendar-picker": "^7.1.3",
    "react-native-modal": "^13.0.1",
    "react-native-swipe-gestures": "^1.0.5",
    "react-native-share": "^10.0.2",
    "react-native-rate": "^1.2.12",
    "react-native-device-info": "^10.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "^0.73.1",
    "@react-native/metro-config": "^0.73.2",
    "@react-native/typescript-config": "^0.73.1",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "^3.0.0",
    "react-test-renderer": "18.2.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  }
}
